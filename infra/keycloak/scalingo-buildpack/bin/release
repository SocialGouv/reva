#!/usr/bin/env bash

if [[ "${KC_FEATURES_PREVIEW_ENABLE}" == "true" ]]; then
cat << EOF
---
addons:
 - scalingo-postgresql
config_vars:
  PATH: "/app/bin:/app/keycloak/bin:/app/java/bin:/usr/local/bin:/usr/bin:/bin"
default_process_types:
  web: /app/keycloak/bin/kc.sh --verbose start --features="token-exchange:v1,admin-fine-grained-authz:v1"
EOF
else
cat << EOF
---
addons:
 - scalingo-postgresql
config_vars:
  PATH: "/app/bin:/app/keycloak/bin:/app/java/bin:/usr/local/bin:/usr/bin:/bin"
default_process_types:
  web: /app/keycloak/bin/kc.sh --verbose start
EOF
fi
